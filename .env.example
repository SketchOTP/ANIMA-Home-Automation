# Local development only. Copy to .env; never commit .env.
ANIMA_ENV=development
ANIMA_LOG_LEVEL=INFO
ANIMA_DATABASE_URL=postgresql://anima:anima_dev_only@localhost:55432/anima
ANIMA_DB_CONNECT_TIMEOUT=5
ANIMA_DB_NAME=anima
ANIMA_DB_USER=anima
ANIMA_DB_PASSWORD=anima_dev_only
ANIMA_DB_PORT=55432
ANIMA_BACKUP_DIR=/var/lib/anima/backups
SEARXNG_SECRET=replace_with_a_local_random_value

# Set to sentry only when the host-owned SENTRY bridge/MCP processes are
# commissioned. The default keeps the embedded AgentRuntime as a deterministic
# reference provider for local development.
ANIMA_INTELLIGENCE_PROVIDER=embedded_reference
ANIMA_HOUSEHOLD_ID=
ANIMA_SENTRY_WORKER_ID=

# Optional commissioned Home Assistant runtime. The token is operator secret
# material and is read only by the Core SecretBroker; never commit it.
ANIMA_HA_BASE_URL=
# Browser-visible HA URL. Set this separately when the Core container reaches
# HA through an internal hostname but the owner's browser uses another one.
ANIMA_HA_BROWSER_URL=
ANIMA_HA_OAUTH_CLIENT_ID=
ANIMA_HA_OAUTH_REDIRECT_URI=
ANIMA_HA_INSTANCE_ID=
ANIMA_HA_PROVIDER_SCOPE=
ANIMA_HA_WEBSOCKET_URL=
ANIMA_HA_TOKEN_SECRET_NAME=HA_ACCESS_TOKEN
# Existing test pin; use 2026.9.0 only for that explicitly supported owner runtime.
ANIMA_HA_EXPECTED_VERSION=2026.8.2
# Compose provides the private connection volume; owner OAuth stores its token
# there instead of this environment. Never copy the token into this example.
# Optional trusted operator group/socket bind for the authenticated Core client.
ANIMA_OWNER_BOUNDARY_GROUP=10001
# ANIMA_OWNER_BOUNDARY_HOST_DIR=/absolute/private/owner-boundary
HA_ACCESS_TOKEN=

# Historical/deferred Walmart provider references only. The normal runtime does
# not activate this provider; never commit the private key or put any values in
# model-visible tool arguments.
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_PATH=
