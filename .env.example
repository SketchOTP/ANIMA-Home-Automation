# Local development only. Copy to .env; never commit .env.
ANIMA_ENV=development
ANIMA_LOG_LEVEL=INFO
ANIMA_DATABASE_URL=postgresql://anima:anima_dev_only@localhost:55432/anima
ANIMA_DB_CONNECT_TIMEOUT=5
ANIMA_DB_NAME=anima
ANIMA_DB_USER=anima
ANIMA_DB_PASSWORD=anima_dev_only
ANIMA_DB_PORT=55432
SEARXNG_SECRET=replace_with_a_local_random_value

# Optional Walmart product research. Map these values from the operator's
# existing Walmart.io credential store; never commit the private key or put
# any of these values in model-visible tool arguments.
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_PATH=
